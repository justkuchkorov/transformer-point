# KiCad: local history (it has its own hidden git inside), lock files, personal view settings
hardware/transformer-point/.history/
*.lck
*.kicad_prl
fp-info-cache
*-backups/

# Wi-Fi name and password stay on this laptop, never on GitHub
secrets.h

# PyCharm settings and the Python environment are personal to this laptop
.idea/
.venv/

# CODESYS: per-user options, the "project is open" lock file and build caches (all rebuilt from the .project)
*.opt
*.~u
*.compileinfo
*.bootinfo
*.bootinfo_guids
*.precompilecache

# Transfer logs: only the run shown in the README is kept in git
logs/*
!logs/ats_2026-11-08_02-34-49.csv
!logs/ats_2026-11-08_02-34-49.png
